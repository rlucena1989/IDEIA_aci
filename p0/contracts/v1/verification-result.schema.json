{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ideia.invalid/p0/v1/verification-result.schema.json",
  "title": "IDEIA P0 VerificationResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "verification_id",
    "task_id",
    "criterion_id",
    "method",
    "verifier_id",
    "verifier_version",
    "independent_from_executor",
    "status",
    "evidence",
    "summary",
    "performed_at"
  ],
  "properties": {
    "contract": {
      "const": "ideia.verification-result/1"
    },
    "verification_id": {
      "$ref": "_defs.schema.json#/$defs/verificationId"
    },
    "task_id": {
      "$ref": "_defs.schema.json#/$defs/taskId"
    },
    "criterion_id": {
      "$ref": "_defs.schema.json#/$defs/criterionId"
    },
    "method": {
      "enum": [
        "command",
        "inspection",
        "artifact",
        "state"
      ]
    },
    "verifier_id": {
      "$ref": "_defs.schema.json#/$defs/stableName"
    },
    "verifier_version": {
      "$ref": "_defs.schema.json#/$defs/version"
    },
    "independent_from_executor": {
      "type": "boolean"
    },
    "status": {
      "$ref": "_defs.schema.json#/$defs/verificationStatus"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "_defs.schema.json#/$defs/evidenceRef"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "performed_at": {
      "$ref": "_defs.schema.json#/$defs/utcTimestamp"
    }
  }
}
