{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ideia.invalid/p0/v1/plan-step.schema.json",
  "title": "IDEIA P0 PlanStep v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "plan_id",
    "step_id",
    "task_id",
    "position",
    "description",
    "preconditions",
    "tool",
    "effect_class",
    "expected_effect",
    "risk",
    "criterion_ids"
  ],
  "properties": {
    "contract": {
      "const": "ideia.plan-step/1"
    },
    "plan_id": {
      "$ref": "_defs.schema.json#/$defs/planId"
    },
    "step_id": {
      "$ref": "_defs.schema.json#/$defs/stepId"
    },
    "task_id": {
      "$ref": "_defs.schema.json#/$defs/taskId"
    },
    "position": {
      "$ref": "_defs.schema.json#/$defs/nonNegativeSafeInteger"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "_defs.schema.json#/$defs/precondition"
      }
    },
    "tool": {
      "$ref": "_defs.schema.json#/$defs/toolRef"
    },
    "effect_class": {
      "$ref": "_defs.schema.json#/$defs/effectClass"
    },
    "expected_effect": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "$ref": "_defs.schema.json#/$defs/riskLevel"
    },
    "criterion_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "_defs.schema.json#/$defs/criterionId"
      }
    }
  }
}
