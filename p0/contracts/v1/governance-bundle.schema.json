{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ideia.invalid/p0/v1/governance-bundle.schema.json",
  "title": "IDEIA P0 GovernanceBundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "bundle_id", "bundle_version", "status", "provider", "prompts", "policy",
    "tool_catalog_fingerprint", "context_strategy", "limits_profile_fingerprint",
    "measurement_profile_fingerprint", "evaluation_report_id", "evaluation_report_fingerprint",
    "approved_by", "approved_at", "effective_at", "expires_at", "candidate_fingerprint", "bundle_fingerprint"
  ],
  "properties": {
    "contract": { "const": "ideia.governance-bundle/1" },
    "bundle_id": { "$ref": "_defs.schema.json#/$defs/stableName" },
    "bundle_version": { "$ref": "_defs.schema.json#/$defs/version" },
    "status": { "enum": ["draft", "evaluated", "approved", "retired"] },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "endpoint_profile", "model_id", "model_revision", "config_fingerprint", "capabilities_fingerprint"],
      "properties": {
        "provider_id": { "$ref": "_defs.schema.json#/$defs/stableName" },
        "endpoint_profile": { "$ref": "_defs.schema.json#/$defs/stableName" },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_revision": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 256 },
            { "type": "null" }
          ]
        },
        "config_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" },
        "capabilities_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt_id", "prompt_version", "prompt_fingerprint"],
        "properties": {
          "prompt_id": { "$ref": "_defs.schema.json#/$defs/stableName" },
          "prompt_version": { "$ref": "_defs.schema.json#/$defs/version" },
          "prompt_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_fingerprint"],
      "properties": {
        "policy_id": { "$ref": "_defs.schema.json#/$defs/stableName" },
        "policy_version": { "$ref": "_defs.schema.json#/$defs/version" },
        "policy_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" }
      }
    },
    "tool_catalog_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" },
    "context_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_id", "strategy_version", "strategy_fingerprint"],
      "properties": {
        "strategy_id": { "$ref": "_defs.schema.json#/$defs/stableName" },
        "strategy_version": { "$ref": "_defs.schema.json#/$defs/version" },
        "strategy_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" }
      }
    },
    "limits_profile_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" },
    "measurement_profile_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" },
    "evaluation_report_id": {
      "oneOf": [
        { "$ref": "_defs.schema.json#/$defs/stableName" },
        { "type": "null" }
      ]
    },
    "evaluation_report_fingerprint": {
      "oneOf": [
        { "$ref": "_defs.schema.json#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "approved_by": {
      "oneOf": [
        { "$ref": "_defs.schema.json#/$defs/principalId" },
        { "type": "null" }
      ]
    },
    "approved_at": {
      "oneOf": [
        { "$ref": "_defs.schema.json#/$defs/utcTimestamp" },
        { "type": "null" }
      ]
    },
    "effective_at": {
      "oneOf": [
        { "$ref": "_defs.schema.json#/$defs/utcTimestamp" },
        { "type": "null" }
      ]
    },
    "expires_at": {
      "oneOf": [
        { "$ref": "_defs.schema.json#/$defs/utcTimestamp" },
        { "type": "null" }
      ]
    },
    "candidate_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" },
    "bundle_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": {
          "evaluation_report_id": { "$ref": "_defs.schema.json#/$defs/stableName" },
          "evaluation_report_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" },
          "approved_by": { "$ref": "_defs.schema.json#/$defs/principalId" },
          "approved_at": { "$ref": "_defs.schema.json#/$defs/utcTimestamp" },
          "effective_at": { "$ref": "_defs.schema.json#/$defs/utcTimestamp" }
        }
      }
    }
  ]
}
