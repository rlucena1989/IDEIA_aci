{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ideia.invalid/p0/v1/evaluation-report.schema.json",
  "title": "IDEIA P0 EvaluationReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "report_id", "report_version", "evaluation_task_id", "candidate_fingerprint", "baseline_candidate_fingerprint",
    "corpus", "runner_fingerprint", "measurement_profile_fingerprint", "started_at", "finished_at",
    "case_count", "results_artifact_id", "results_ref", "metrics", "hard_gates", "verdict", "report_fingerprint"
  ],
  "properties": {
    "contract": { "const": "ideia.evaluation-report/1" },
    "report_id": { "$ref": "_defs.schema.json#/$defs/stableName" },
    "report_version": { "$ref": "_defs.schema.json#/$defs/version" },
    "evaluation_task_id": { "$ref": "_defs.schema.json#/$defs/taskId" },
    "candidate_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" },
    "baseline_candidate_fingerprint": {
      "oneOf": [
        { "$ref": "_defs.schema.json#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "corpus_version", "corpus_digest", "split_profile_fingerprint"],
      "properties": {
        "corpus_id": { "$ref": "_defs.schema.json#/$defs/stableName" },
        "corpus_version": { "$ref": "_defs.schema.json#/$defs/version" },
        "corpus_digest": { "$ref": "_defs.schema.json#/$defs/digest" },
        "split_profile_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" }
      }
    },
    "runner_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" },
    "measurement_profile_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" },
    "started_at": { "$ref": "_defs.schema.json#/$defs/utcTimestamp" },
    "finished_at": { "$ref": "_defs.schema.json#/$defs/utcTimestamp" },
    "case_count": { "$ref": "_defs.schema.json#/$defs/positiveSafeInteger" },
    "results_artifact_id": { "$ref": "_defs.schema.json#/$defs/artifactId" },
    "results_ref": { "$ref": "_defs.schema.json#/$defs/artifactRef" },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "unit", "numerator", "denominator", "sample_count", "classification"],
        "properties": {
          "metric_id": { "$ref": "_defs.schema.json#/$defs/stableName" },
          "unit": { "$ref": "_defs.schema.json#/$defs/stableName" },
          "numerator": { "$ref": "_defs.schema.json#/$defs/nonNegativeSafeInteger" },
          "denominator": { "$ref": "_defs.schema.json#/$defs/positiveSafeInteger" },
          "sample_count": { "$ref": "_defs.schema.json#/$defs/positiveSafeInteger" },
          "classification": { "enum": ["primary", "secondary", "diagnostic"] }
        }
      }
    },
    "hard_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "outcome", "passed_cases", "total_cases", "evidence_digest"],
        "properties": {
          "gate_id": { "$ref": "_defs.schema.json#/$defs/stableName" },
          "outcome": { "enum": ["pass", "fail", "blocked"] },
          "passed_cases": { "$ref": "_defs.schema.json#/$defs/nonNegativeSafeInteger" },
          "total_cases": { "$ref": "_defs.schema.json#/$defs/positiveSafeInteger" },
          "evidence_digest": { "$ref": "_defs.schema.json#/$defs/digest" }
        }
      }
    },
    "verdict": { "enum": ["promote", "hold", "reject", "inconclusive"] },
    "report_fingerprint": { "$ref": "_defs.schema.json#/$defs/digest" }
  }
}
