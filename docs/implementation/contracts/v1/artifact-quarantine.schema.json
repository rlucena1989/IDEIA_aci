{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ideia.invalid/p0/v1/artifact-quarantine.schema.json",
  "title": "IDEIA P0 ArtifactQuarantine v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "artifact_id",
    "task_id",
    "artifact_digest",
    "previous_lifecycle",
    "reason_code",
    "evidence_digest",
    "byte_disposition",
    "detected_at"
  ],
  "properties": {
    "contract": { "const": "ideia.artifact-quarantine/1" },
    "artifact_id": { "$ref": "_defs.schema.json#/$defs/artifactId" },
    "task_id": { "$ref": "_defs.schema.json#/$defs/taskId" },
    "artifact_digest": { "$ref": "_defs.schema.json#/$defs/digest" },
    "previous_lifecycle": { "enum": ["staged", "committed"] },
    "reason_code": { "$ref": "_defs.schema.json#/$defs/stableName" },
    "evidence_digest": {
      "oneOf": [
        { "$ref": "_defs.schema.json#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "byte_disposition": { "enum": ["retained_blocked", "moved_to_quarantine", "missing"] },
    "detected_at": { "$ref": "_defs.schema.json#/$defs/utcTimestamp" }
  }
}
